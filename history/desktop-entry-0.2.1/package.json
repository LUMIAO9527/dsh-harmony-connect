{
  "name": "dsh-harmony-connect",
  "version": "0.1.3-preview.1",
  "private": true,
  "type": "module",
  "description": "在原版 DSH Web 中管理电脑，并适配手机和平板界面",
  "displayName": "DSH 鸿蒙连接器",
  "files": ["index.js", "client.js", "gateway-bootstrap.js", "cordis.patch.yml", "locale/*.json"],
  "peerDependencies": { "dsh-mobile": "0.6.18" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
